# Copy this file to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Port the API listens on (Render/Railway/Fly set PORT for you).
PORT=3000

# Shared secret protecting every /api/* route. Send it as the
# `x-api-key` header. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me-to-a-long-random-secret

# Postgres connection string. Local example:
#   postgres://pricehawk:pricehawk@localhost:5432/pricehawk
DATABASE_URL=postgres://pricehawk:pricehawk@localhost:5432/pricehawk

# Comma-separated list of website origins allowed to call the API
# from a browser (the PriceHawk site). Example:
#   CORS_ORIGINS=https://pricehawk.example.com,http://localhost:5173
# Use "*" to allow any origin (safe for the public search/compare
# endpoints: no cookies or credentials are involved).
CORS_ORIGINS=

# How long a fetched price is cached (seconds). Default 900 = 15 min.
CACHE_TTL_SECONDS=900

# How long a product-search result is cached (seconds). Default 300 = 5 min.
SEARCH_CACHE_TTL_SECONDS=300

# Global rate limit: max requests per IP per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Stricter per-IP limit for the expensive endpoints (/api/search, /api/compare).
SEARCH_RATE_LIMIT_MAX=20

# Free currency-rate source (no key needed). Used only to convert
# mixed-currency comparison sets; the rates timestamp is returned
# with every converted response.
FX_API_URL=https://open.er-api.com/v6/latest/USD

NODE_ENV=development
